{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "declarationDir": "lib/types"
  },
  "include": [
    "src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "src/client"
  ]
}
